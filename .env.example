# ============================================================
# Phosop API config — supports DEVNET and MAINNET side by side.
# Test API keys (sk_p_test_...) route to devnet.
# Live API keys (sk_p_live_...) route to mainnet-beta.
# ============================================================
NODE_ENV=development
PORT=3333
MONGODB_URI=mongodb://localhost:27017/phosop

# ---- Which networks are enabled on this server ----
ENABLE_DEVNET=true
ENABLE_MAINNET=false

# ---- Wallet secret encryption (recommended) ----
# Wallet secrets below may be plaintext base58 (dev) OR encrypted "enc.v1:...".
# Encrypt with:  pnpm --filter @phosop/api encrypt-secret "<base58-secret>"
# WALLET_MASTER_KEY should come from your KMS/secrets manager, not the repo.
WALLET_MASTER_KEY=
# Refuse to boot with plaintext wallet secrets in production unless set true.
ALLOW_PLAINTEXT_SECRETS=false

# ---- DEVNET (safe sandbox; fake money) ----
DEVNET_RPC_URL=https://api.devnet.solana.com
DEVNET_RPC_FALLBACK_URL=https://api.devnet.solana.com
DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
DEVNET_PLATFORM_WALLET_SECRET=
DEVNET_FEE_PAYER_WALLET_SECRET=

# ---- MAINNET (real USDC; irreversible) ----
MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
MAINNET_RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com
MAINNET_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MAINNET_PLATFORM_WALLET_SECRET=
MAINNET_FEE_PAYER_WALLET_SECRET=

# ---- Security ----
# Generate unique 32+ character values for every deployment.
# Production startup rejects empty values and obvious placeholders.
API_KEY_PEPPER=
ADMIN_API_SECRET=
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_MS=10000
ALLOW_PRIVATE_WEBHOOK_URLS=false
CORS_ORIGINS=http://localhost:5173,http://localhost:4204

# ---- Payout policy ----
# Amounts are in smallest USDC units (6 decimals). 1 USDC = 1000000.
MIN_PAYOUT_UNITS=10000            # 0.01 USDC minimum
MAX_PAYOUT_UNITS=100000000000     # 100,000 USDC maximum per payout
MAX_BATCH_SIZE=50                 # max payouts per batch request
SUPPORTED_CURRENCIES=usdc

# ---- Ops ----
LOW_BALANCE_ALERT_USDC=100
LOW_FEE_PAYER_SOL=0.05
RECONCILE_TIMEOUT_SECONDS=120     # pending payouts older than this get reconciled
RECONCILE_GIVEUP_SECONDS=3600     # broadcast-but-unconfirmed payouts fail only after this
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# ---- Observability & alerting ----
LOG_FORMAT=json                  # json | (empty for human-readable)
LOG_LEVEL=log                    # error | warn | log | debug | verbose
METRICS_PUBLIC=false             # production default should stay false
METRICS_TOKEN=                   # 32+ chars; use Authorization: Bearer <token> to scrape /v1/metrics
SLACK_WEBHOOK_URL=               # optional: Slack-compatible incoming webhook for alerts
ALERT_MIN_INTERVAL_SECONDS=300   # de-dupe window per alert key
